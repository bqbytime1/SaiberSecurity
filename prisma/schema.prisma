generator client {
  provider = "prisma-client-js"
}

// PostgreSQL rather than SQLite, because the database has to outlive the process.
// A hosted container's filesystem is disposable: it is rebuilt on every deploy and,
// on services that sleep when idle, on every wake. A SQLite file there takes every
// account, session and collected event with it each time.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The tenancy boundary. Every security event and incident belongs to exactly one
/// organization, and a signed-in user only ever sees their own. Signing up creates a
/// new organization, so a new account always starts empty.
model Organization {
  id                   String          @id @default(cuid())
  name                 String          @default("My organization")
  detectionSensitivity String          @default("MEDIUM")
  autoSimulate         Boolean         @default(false)
  autoSimulateInterval Int             @default(45)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  users                User[]
  events               SecurityEvent[]
  incidents            Incident[]
}

// A user may authenticate by password, by a linked identity provider, or by phone,
// so email and passwordHash are both optional. At least one identifier is enforced
// in application code (see lib/accounts.ts).
model User {
  id             String       @id @default(cuid())
  email          String?      @unique
  emailVerified  DateTime?
  phone          String?      @unique
  phoneVerified  DateTime?
  passwordHash   String?
  name           String
  image          String?
  signupMethod   String       @default("password")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  sessions       Session[]
  accounts       Account[]

  @@index([organizationId])
}

/// A federated identity linked to a user (Google, Microsoft, GitHub, ...).
model Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Short-lived one-time codes for phone sign-up and sign-in. Only a keyed hash of
/// the code is stored, and each row tracks its own attempt count.
model VerificationCode {
  id         String    @id @default(cuid())
  channel    String    @default("phone")
  target     String
  codeHash   String
  name       String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SecurityEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timestamp      DateTime
  source         String
  eventType      String
  user           String?
  sourceIp       String
  destinationIp  String?
  country        String?
  device         String?
  action         String
  status         String
  metadata       String?
  anomalyScore   Int          @default(0)
  riskScore      Int          @default(0)
  severity       String       @default("LOW")
  scoreFactors   String?
  incidentId     String?
  incident       Incident?    @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  // Every read is scoped by organization, so it leads each composite index.
  @@index([organizationId, timestamp])
  @@index([organizationId, severity])
  @@index([organizationId, riskScore])
  @@index([organizationId, eventType])
  @@index([organizationId, sourceIp])
  @@index([organizationId, user])
  @@index([organizationId, source])
  @@index([incidentId])
}

model Incident {
  id                 String          @id @default(cuid())
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title              String
  description        String
  severity           String
  riskScore          Int
  status             String          @default("OPEN")
  category           String
  correlationKey     String
  eventCount         Int             @default(0)
  affectedUser       String?
  primaryIp          String?
  detectionReasons   String?
  aiExplanation      String?
  recommendedActions String?
  aiProvider         String          @default("local")
  events             SecurityEvent[]
  firstEventAt       DateTime
  lastEventAt        DateTime
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  resolvedAt         DateTime?

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  // Correlation looks up an open incident by key within one organization.
  @@index([organizationId, correlationKey])
}
