# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. The app needs a real database server; there is no
# file-based fallback, because a file inside a container is deleted on every deploy
# and takes every account and session with it.
#
# For local development, either install PostgreSQL or run one in Docker:
#   docker run -d --name saiber-pg -p 5432:5432 \
#     -e POSTGRES_PASSWORD=saiberlocal -e POSTGRES_DB=saiber postgres:17-alpine
# then apply the schema with:
#   npx prisma migrate deploy
DATABASE_URL="postgresql://postgres:saiberlocal@127.0.0.1:5432/saiber?schema=public"

# Secret used to sign session cookies. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public origin used to build OAuth callback URLs. Falls back to the request origin.
APP_URL="http://localhost:3000"

# Show the demo credentials under the sign-in form. Defaults to on outside
# production and off in production, where printing them would publish a working
# login to every visitor. Set "true"/"false" to override.
SHOW_DEMO_CREDENTIALS=""

# ── Optional: email, for password reset ──────────────────────────────────────
# Any HTTP mail API taking a JSON body of from/to/subject/text works, such as
# Resend (https://api.resend.com/emails) or Postmark. Without these, and only
# outside production, the reset link is written to the server log and shown in the
# form so the flow can be tested locally.
MAIL_API_URL=""
MAIL_API_KEY=""
MAIL_FROM="SaiberSecurity <security@saibersecurity.com>"

# ── Live host monitoring ─────────────────────────────────────────────────────
# Reads this machine's own TCP connection table and DNS cache on a timer and feeds
# the results through the normal scoring pipeline. It is real, observed activity,
# not packet capture: no payloads, no byte counts, and only this host's traffic.
# Defaults to on outside production. On a server it would report the server's own
# outbound traffic, so it defaults to off when NODE_ENV=production.
HOST_MONITOR_ENABLED=""
# How often to sample, in milliseconds. Minimum 5000.
HOST_MONITOR_INTERVAL_MS="15000"

# ── Optional: single sign-on providers ───────────────────────────────────────
# Each provider is offered on the sign-in and sign-up pages only when both of its
# values are set; otherwise its button renders disabled.
# Callback URL to register: {APP_URL}/api/auth/oauth/{provider}/callback
#   Google     → https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
#   Microsoft  → https://entra.microsoft.com (App registrations)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"
#   GitHub     → https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Optional: SMS for phone sign-up ──────────────────────────────────────────
# Without these, phone sign-up still works outside production: the one-time code is
# written to the server log and shown in the UI instead of being texted.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Optional: AI provider (OpenAI-compatible chat completions API) ───────────
# Leave AI_API_KEY blank to use the built-in deterministic analysis engine.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
