# Production environment for saibersecurity.com.
# Copy to .env.production on the server, fill in, and keep it out of version control.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production

# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
#
# With docker-compose, leave this as it is and set POSTGRES_PASSWORD below instead:
# compose overrides DATABASE_URL to point at the `db` service beside the app.
# On a managed host such as Render, paste that instance's Internal Database URL here
# (or set it in the dashboard) and ignore POSTGRES_PASSWORD.
DATABASE_URL=""

# Password for the bundled PostgreSQL container. docker-compose builds DATABASE_URL
# from it, so it only matters when you run the compose stack.
POSTGRES_PASSWORD=""

# Generate a fresh one for production and never reuse the development value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this signs every existing session out.
SESSION_SECRET=""

# Public origin. Must match the certificate and the OAuth redirect URIs exactly,
# with no trailing slash.
APP_URL="https://saibersecurity.com"

# Marks session cookies Secure and enables HSTS.
NODE_ENV="production"

# Load the synthetic demo dataset on first boot. Off by default, so a new deployment
# starts empty and fills only with activity the collector actually observes. Turn it
# on only if you want invented incidents to demonstrate the console with.
SEED_ON_FIRST_BOOT="false"

# The built-in demo account is skipped in a container unless you give it a password,
# because the default one is published in this repository. Leave this unset and sign
# up for your own account at /signup instead.
DEMO_USER_PASSWORD=""

# Leave this unset. In production the demo credentials are hidden automatically;
# setting it to "true" would print a working login on your public sign-in page.
SHOW_DEMO_CREDENTIALS="false"

# ── Email, for password reset ───────────────────────────────────────────────
# Set these to deliver real mail. Any HTTP API taking from/to/subject/text works;
# for Resend use https://api.resend.com/emails.
#
# With no provider, the reset link is written to the server log instead, which is the
# default. That is safe on a public site, because reading it needs access to your
# hosting dashboard rather than just the ability to submit the form, and the response
# itself carries nothing. Set MAIL_TRANSPORT="none" to switch password reset off.
MAIL_TRANSPORT=""
#
# Leave MAIL_DEV_FALLBACK unset. Setting it to "true" returns the reset link in the
# HTTP response, which on a reachable deployment is a way into any account.
MAIL_API_URL=""
MAIL_API_KEY=""
MAIL_FROM="SaiberSecurity <security@saibersecurity.com>"

# ── Live host monitoring ────────────────────────────────────────────────────
# Off by default in production, because on a server this reports the server's own
# outbound connections rather than anything about your users. Turn it on only if
# monitoring this host is what you actually want.
HOST_MONITOR_ENABLED="false"
HOST_MONITOR_INTERVAL_MS="15000"

# Which organization the collector's events belong to. It runs on a timer with nobody
# signed in, so it cannot infer a tenant from a request. Leave this empty to use the
# oldest organization, which is the right one on a single-operator deployment.
HOST_MONITOR_ORG_ID=""

# ── Optional: single sign-on ────────────────────────────────────────────────
# Register this redirect URI with each provider you enable:
#   https://saibersecurity.com/api/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Optional: SMS for phone sign-up ─────────────────────────────────────────
# Required in production: with NODE_ENV=production and no provider, the phone
# endpoints return 503 rather than revealing a code.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Optional: AI analysis ───────────────────────────────────────────────────
# Leave the key empty to keep using the deterministic local engine.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
