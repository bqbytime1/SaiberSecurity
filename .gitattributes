# Shell scripts and container files must keep LF endings, or a CRLF checkout on
# Windows produces a script Linux cannot execute ("bad interpreter").
* text=auto eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
docker-entrypoint.sh text eol=lf
Caddyfile text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.db binary
